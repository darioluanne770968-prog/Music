generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== User Models ====================

model User {
  id            Int       @id @default(autoincrement())
  username      String    @unique @db.VarChar(50)
  email         String?   @unique @db.VarChar(100)
  phone         String?   @unique @db.VarChar(20)
  passwordHash  String    @map("password_hash") @db.VarChar(255)
  avatar        String?   @db.VarChar(500)
  bio           String?   @db.Text
  level         Int       @default(1)
  exp           Int       @default(0)
  vipLevel      Int       @default(0) @map("vip_level")
  vipExpireAt   DateTime? @map("vip_expire_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  // Relations
  settings      UserSettings?
  followers     UserFollow[]    @relation("followers")
  following     UserFollow[]    @relation("following")
  playlists     Playlist[]
  likes         UserLike[]
  comments      Comment[]
  playHistory   PlayHistory[]
  activities    UserActivity[]
  achievements  UserAchievement[]
  messagesSent  Message[]       @relation("sender")
  messagesReceived Message[]    @relation("receiver")
  downloads     Download[]
  notifications Notification[]

  @@map("users")
}

model UserSettings {
  userId        Int      @id @map("user_id")
  theme         String   @default("auto") @db.VarChar(20)
  quality       String   @default("high") @db.VarChar(20)
  language      String   @default("zh-CN") @db.VarChar(10)
  notifications Json     @default("{}")
  privacy       Json     @default("{}")
  equalizer     Json     @default("{}")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model UserFollow {
  followerId  Int      @map("follower_id")
  followingId Int      @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("following", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@map("user_follows")
}

model UserAchievement {
  userId        Int      @map("user_id")
  achievementId Int      @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
  @@map("user_achievements")
}

model Achievement {
  id          Int    @id @default(autoincrement())
  name        String @db.VarChar(100)
  description String @db.Text
  icon        String @db.VarChar(500)
  condition   Json

  users UserAchievement[]

  @@map("achievements")
}

// ==================== Music Models ====================

model Artist {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(100)
  avatar        String?   @db.VarChar(500)
  cover         String?   @db.VarChar(500)
  bio           String?   @db.Text
  country       String?   @db.VarChar(50)
  birthDate     DateTime? @map("birth_date")
  genres        Json      @default("[]")
  isVerified    Boolean   @default(false) @map("is_verified")
  followerCount Int       @default(0) @map("follower_count")
  createdAt     DateTime  @default(now()) @map("created_at")

  songs  Song[]
  albums Album[]
  mvs    MV[]

  @@map("artists")
}

model Album {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(200)
  artistId    Int       @map("artist_id")
  cover       String?   @db.VarChar(500)
  releaseDate DateTime? @map("release_date")
  description String?   @db.Text
  genre       String?   @db.VarChar(50)
  type        String    @default("album") @db.VarChar(20) // album, single, ep
  createdAt   DateTime  @default(now()) @map("created_at")

  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)
  songs  Song[]

  @@map("albums")
}

model Song {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(200)
  artistId     Int       @map("artist_id")
  albumId      Int?      @map("album_id")
  duration     Int       // seconds
  fileUrl128   String?   @map("file_url_128") @db.VarChar(500)
  fileUrl320   String?   @map("file_url_320") @db.VarChar(500)
  fileUrlFlac  String?   @map("file_url_flac") @db.VarChar(500)
  cover        String?   @db.VarChar(500)
  genre        String?   @db.VarChar(50)
  language     String?   @db.VarChar(20)
  releaseDate  DateTime? @map("release_date")
  playCount    BigInt    @default(0) @map("play_count")
  likeCount    Int       @default(0) @map("like_count")
  commentCount Int       @default(0) @map("comment_count")
  isVip        Boolean   @default(false) @map("is_vip")
  createdAt    DateTime  @default(now()) @map("created_at")

  artist       Artist          @relation(fields: [artistId], references: [id], onDelete: Cascade)
  album        Album?          @relation(fields: [albumId], references: [id], onDelete: SetNull)
  lyrics       Lyrics[]
  mv           MV?
  playlists    PlaylistSong[]
  likes        UserLike[]
  comments     Comment[]
  playHistory  PlayHistory[]
  downloads    Download[]

  @@map("songs")
}

model Lyrics {
  id            Int      @id @default(autoincrement())
  songId        Int      @map("song_id")
  content       String   @db.Text
  translated    String?  @db.Text
  romanized     String?  @db.Text
  type          String   @default("lrc") @db.VarChar(20) // lrc, krc, qrc
  language      String?  @db.VarChar(20)
  contributorId Int?     @map("contributor_id")
  createdAt     DateTime @default(now()) @map("created_at")

  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("lyrics")
}

model MV {
  id        Int      @id @default(autoincrement())
  songId    Int      @unique @map("song_id")
  name      String   @db.VarChar(200)
  artistId  Int      @map("artist_id")
  cover     String?  @db.VarChar(500)
  url360    String?  @map("url_360") @db.VarChar(500)
  url720    String?  @map("url_720") @db.VarChar(500)
  url1080   String?  @map("url_1080") @db.VarChar(500)
  url4k     String?  @map("url_4k") @db.VarChar(500)
  duration  Int?
  playCount BigInt   @default(0) @map("play_count")
  createdAt DateTime @default(now()) @map("created_at")

  song   Song   @relation(fields: [songId], references: [id], onDelete: Cascade)
  artist Artist @relation(fields: [artistId], references: [id], onDelete: Cascade)

  @@map("mvs")
}

// ==================== Playlist Models ====================

model Playlist {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(200)
  userId      Int      @map("user_id")
  cover       String?  @db.VarChar(500)
  description String?  @db.Text
  tags        Json     @default("[]")
  isPublic    Boolean  @default(true) @map("is_public")
  isOfficial  Boolean  @default(false) @map("is_official")
  playCount   BigInt   @default(0) @map("play_count")
  likeCount   Int      @default(0) @map("like_count")
  songCount   Int      @default(0) @map("song_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  songs PlaylistSong[]

  @@map("playlists")
}

model PlaylistSong {
  playlistId Int      @map("playlist_id")
  songId     Int      @map("song_id")
  sortOrder  Int      @default(0) @map("sort_order")
  addedAt    DateTime @default(now()) @map("added_at")

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  song     Song     @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([playlistId, songId])
  @@map("playlist_songs")
}

// ==================== Social Models ====================

model Comment {
  id         Int       @id @default(autoincrement())
  userId     Int       @map("user_id")
  targetType String    @map("target_type") @db.VarChar(20) // song, playlist, mv, album
  targetId   Int       @map("target_id")
  content    String    @db.Text
  images     Json      @default("[]")
  parentId   Int?      @map("parent_id")
  likeCount  Int       @default(0) @map("like_count")
  replyCount Int       @default(0) @map("reply_count")
  isHot      Boolean   @default(false) @map("is_hot")
  createdAt  DateTime  @default(now()) @map("created_at")

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("replies")
  song    Song?     @relation(fields: [targetId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model UserActivity {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  type         String   @db.VarChar(50) // share_song, create_playlist, follow_user
  content      Json
  likeCount    Int      @default(0) @map("like_count")
  commentCount Int      @default(0) @map("comment_count")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_activities")
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int      @map("sender_id")
  receiverId Int      @map("receiver_id")
  content    String   @db.Text
  type       String   @default("text") @db.VarChar(20) // text, image, song, playlist
  extra      Json?
  isRead     Boolean  @default(false) @map("is_read")
  createdAt  DateTime @default(now()) @map("created_at")

  sender   User @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String   @db.VarChar(50) // comment, like, follow, system
  title     String   @db.VarChar(200)
  content   String   @db.Text
  extra     Json?
  isRead    Boolean  @default(false) @map("is_read")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ==================== Play & Stats Models ====================

model UserLike {
  userId    Int      @map("user_id")
  songId    Int      @map("song_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@id([userId, songId])
  @@map("user_likes")
}

model PlayHistory {
  id       Int      @id @default(autoincrement())
  userId   Int      @map("user_id")
  songId   Int      @map("song_id")
  playedAt DateTime @default(now()) @map("played_at")
  duration Int?     // actual played duration in seconds
  source   String?  @db.VarChar(50) // playlist, album, search, recommend
  device   String?  @db.VarChar(50)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("play_history")
}

model Download {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  songId       Int      @map("song_id")
  quality      String   @db.VarChar(20)
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  song Song @relation(fields: [songId], references: [id], onDelete: Cascade)

  @@map("downloads")
}

model DailyStat {
  id           Int      @id @default(autoincrement())
  userId       Int      @map("user_id")
  date         DateTime @db.Date
  playCount    Int      @default(0) @map("play_count")
  playDuration Int      @default(0) @map("play_duration") // seconds
  genres       Json     @default("{}")
  artists      Json     @default("{}")
  moods        Json     @default("{}")

  @@unique([userId, date])
  @@map("daily_stats")
}

model Chart {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  type      String   @db.VarChar(50) // hot, new, soar, genre
  songs     Json     // [{songId, rank, change}]
  date      DateTime @db.Date
  createdAt DateTime @default(now()) @map("created_at")

  @@map("charts")
}

// ==================== AI Models ====================

model AIComposition {
  id            Int       @id @default(autoincrement())
  userId        Int       @map("user_id")
  title         String    @db.VarChar(200)
  description   String?   @db.Text
  inputType     String    @map("input_type") @db.VarChar(20) // humming, lyrics, style
  inputData     String?   @map("input_data") @db.Text
  style         String    @db.VarChar(50)
  mood          String    @db.VarChar(50)
  tempo         Int       @default(120)
  musicalKey    String?   @map("musical_key") @db.VarChar(10)
  generatedUrl  String?   @map("generated_url") @db.VarChar(500)
  stems         Json      @default("[]")
  status        String    @default("pending") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("ai_compositions")
}

model AICover {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  originalSongId Int      @map("original_song_id")
  voiceModelId   Int      @map("voice_model_id")
  style          String?  @db.VarChar(50)
  pitch          Int      @default(0)
  generatedUrl   String?  @map("generated_url") @db.VarChar(500)
  status         String   @default("pending") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")

  voiceModel VoiceModel @relation(fields: [voiceModelId], references: [id])

  @@map("ai_covers")
}

model VoiceModel {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  artistName String?  @map("artist_name") @db.VarChar(100)
  avatarUrl  String?  @map("avatar_url") @db.VarChar(500)
  voiceType  String   @map("voice_type") @db.VarChar(20)
  languages  Json     @default("[]")
  samples    Json     @default("[]")
  isOfficial Boolean  @default(false) @map("is_official")
  usageCount Int      @default(0) @map("usage_count")
  createdAt  DateTime @default(now()) @map("created_at")

  covers AICover[]

  @@map("voice_models")
}

model AIDJSession {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  name        String   @db.VarChar(100)
  tracks      Json     @default("[]")
  transitions Json     @default("[]")
  settings    Json     @default("{}")
  isPlaying   Boolean  @default(false) @map("is_playing")
  bpm         Int      @default(128)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("ai_dj_sessions")
}

model EmotionRecord {
  id             Int      @id @default(autoincrement())
  userId         Int      @map("user_id")
  detectionType  String   @map("detection_type") @db.VarChar(20)
  primaryEmotion String   @map("primary_emotion") @db.VarChar(30)
  intensity      Float    @default(0.5)
  valence        Float    @default(0)
  arousal        Float    @default(0.5)
  playlistId     Int?     @map("playlist_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("emotion_records")
}

model MusicStory {
  id         Int      @id @default(autoincrement())
  userId     Int      @map("user_id")
  type       String   @db.VarChar(20)
  periodStart DateTime @map("period_start")
  periodEnd  DateTime @map("period_end")
  title      String   @db.VarChar(200)
  coverImage String?  @map("cover_image") @db.VarChar(500)
  sections   Json     @default("[]")
  statistics Json     @default("{}")
  insights   Json     @default("[]")
  shareUrl   String?  @map("share_url") @db.VarChar(500)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("music_stories")
}

// ==================== Gaming Models ====================

model BeatMap {
  id         Int      @id @default(autoincrement())
  songId     Int      @map("song_id")
  difficulty String   @db.VarChar(20)
  bpm        Int
  notes      Json     @default("[]")
  duration   Int
  creatorId  Int?     @map("creator_id")
  verified   Boolean  @default(false)
  playCount  Int      @default(0) @map("play_count")
  createdAt  DateTime @default(now()) @map("created_at")

  scores GameScore[]

  @@map("beat_maps")
}

model GameScore {
  id         Int      @id @default(autoincrement())
  beatMapId  Int      @map("beat_map_id")
  userId     Int      @map("user_id")
  score      Int
  accuracy   Float
  maxCombo   Int      @map("max_combo")
  judgments  Json     @default("{}")
  rank       String   @db.VarChar(5)
  createdAt  DateTime @default(now()) @map("created_at")

  beatMap BeatMap @relation(fields: [beatMapId], references: [id], onDelete: Cascade)

  @@map("game_scores")
}

model GuessChallenge {
  id          Int      @id @default(autoincrement())
  hostId      Int      @map("host_id")
  type        String   @db.VarChar(20)
  mode        String   @db.VarChar(20)
  settings    Json     @default("{}")
  status      String   @default("waiting") @db.VarChar(20)
  rounds      Json     @default("[]")
  players     Json     @default("[]")
  currentRound Int     @default(0) @map("current_round")
  createdAt   DateTime @default(now()) @map("created_at")
  endedAt     DateTime? @map("ended_at")

  @@map("guess_challenges")
}

model MusicPet {
  id          Int      @id @default(autoincrement())
  userId      Int      @unique @map("user_id")
  name        String   @db.VarChar(50)
  type        String   @db.VarChar(30)
  level       Int      @default(1)
  experience  Int      @default(0)
  mood        Int      @default(100)
  energy      Int      @default(100)
  skills      Json     @default("[]")
  accessories Json     @default("[]")
  stage       String   @default("egg") @db.VarChar(20)
  stats       Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("music_pets")
}

model VirtualConcert {
  id           Int       @id @default(autoincrement())
  artistId     Int       @map("artist_id")
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  coverImage   String?   @map("cover_image") @db.VarChar(500)
  startTime    DateTime  @map("start_time")
  duration     Int
  venue        Json      @default("{}")
  setlist      Json      @default("[]")
  ticketTypes  Json      @default("[]")
  maxCapacity  Int       @default(10000) @map("max_capacity")
  attendees    Int       @default(0)
  status       String    @default("upcoming") @db.VarChar(20)
  replayUrl    String?   @map("replay_url") @db.VarChar(500)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("virtual_concerts")
}

// ==================== Social Extended Models ====================

model MusicMatch {
  id            Int      @id @default(autoincrement())
  userId        Int      @map("user_id")
  matchedUserId Int      @map("matched_user_id")
  matchScore    Int      @map("match_score")
  commonData    Json     @default("{}")
  status        String   @default("pending") @db.VarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")

  @@unique([userId, matchedUserId])
  @@map("music_matches")
}

model MusicProfile {
  userId            Int      @id @map("user_id")
  topGenres         Json     @default("[]") @map("top_genres")
  topArtists        Json     @default("[]") @map("top_artists")
  personality       Json     @default("{}")
  moodProfile       Json     @default("{}") @map("mood_profile")
  activeHours       Json     @default("[]") @map("active_hours")
  discoveryRate     Float    @default(0.5) @map("discovery_rate")
  socialness        Float    @default(0.5)
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("music_profiles")
}

model CollaborativePlaylist {
  id            Int      @id @default(autoincrement())
  playlistId    Int      @unique @map("playlist_id")
  collaborators Json     @default("[]")
  settings      Json     @default("{}")
  activityLog   Json     @default("[]") @map("activity_log")
  chatRoomId    String?  @map("chat_room_id") @db.VarChar(50)
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("collaborative_playlists")
}

model TimeCapsule {
  id             Int       @id @default(autoincrement())
  senderId       Int       @map("sender_id")
  recipientId    Int?      @map("recipient_id")
  recipientEmail String?   @map("recipient_email") @db.VarChar(100)
  songs          Json      @default("[]")
  message        String    @db.Text
  voiceMessage   String?   @map("voice_message") @db.VarChar(500)
  photos         Json      @default("[]")
  theme          Json      @default("{}")
  unlockDate     DateTime  @map("unlock_date")
  isOpened       Boolean   @default(false) @map("is_opened")
  openedAt       DateTime? @map("opened_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("time_capsules")
}

model SongDanmaku {
  id        Int      @id @default(autoincrement())
  songId    Int      @map("song_id")
  userId    Int      @map("user_id")
  text      String   @db.VarChar(200)
  timestamp Float
  type      String   @default("text") @db.VarChar(20)
  style     Json     @default("{}")
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("song_danmakus")
}

model DriftBottle {
  id             Int       @id @default(autoincrement())
  senderId       Int       @map("sender_id")
  senderName     String    @map("sender_name") @db.VarChar(50)
  songId         Int       @map("song_id")
  message        String    @db.Text
  mood           String?   @db.VarChar(30)
  location       Json?
  theme          Json      @default("{}")
  status         String    @default("drifting") @db.VarChar(20)
  pickerId       Int?      @map("picker_id")
  replies        Json      @default("[]")
  driftDuration  Int       @default(0) @map("drift_duration")
  createdAt      DateTime  @default(now()) @map("created_at")
  pickedAt       DateTime? @map("picked_at")

  @@map("drift_bottles")
}

model FanSupport {
  id           Int       @id @default(autoincrement())
  artistId     Int       @map("artist_id")
  type         String    @db.VarChar(30)
  title        String    @db.VarChar(200)
  description  String?   @db.Text
  target       Int
  current      Int       @default(0)
  participants Json      @default("[]")
  rewards      Json      @default("[]")
  startDate    DateTime  @map("start_date")
  endDate      DateTime  @map("end_date")
  status       String    @default("active") @db.VarChar(20)
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("fan_supports")
}

// ==================== Health Models ====================

model SleepSession {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  startTime      DateTime  @map("start_time")
  endTime        DateTime? @map("end_time")
  soundscapeId   Int?      @map("soundscape_id")
